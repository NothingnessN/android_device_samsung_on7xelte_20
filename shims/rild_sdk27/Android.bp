// SPDX-License-Identifier: Apache-2.0

cc_library_shared {
    name: "librild_sdk27_shim",
    srcs: ["RildSdk27Shim.cpp"],
    compile_multilib: "32",
    // Keep this a system library: libdl_android is a private platform API,
    // not a vendor/LL-NDK library on Android 13.
    shared_libs: [
        "libdl",
        "libdl_android",
        "liblog",
    ],
    stl: "none",
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
}
